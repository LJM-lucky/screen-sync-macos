import AppKit

let folder = URL(fileURLWithPath: CommandLine.arguments[1], isDirectory: true)
try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
func color(_ r: Int, _ g: Int, _ b: Int, _ alpha: CGFloat = 1) -> NSColor {
    NSColor(srgbRed: CGFloat(r) / 255, green: CGFloat(g) / 255, blue: CGFloat(b) / 255, alpha: alpha)
}
func rect(_ x: CGFloat, _ y: CGFloat, _ w: CGFloat, _ h: CGFloat, _ radius: CGFloat) -> NSBezierPath {
    NSBezierPath(roundedRect: NSRect(x: x, y: y, width: w, height: h), xRadius: radius, yRadius: radius)
}
func stroke(_ path: NSBezierPath, _ ink: NSColor, _ width: CGFloat) {
    ink.setStroke()
    path.lineWidth = width
    path.lineCapStyle = .round
    path.stroke()
}
func render(_ size: Int) -> Data {
    let bitmap = NSBitmapImageRep(bitmapDataPlanes: nil, pixelsWide: size, pixelsHigh: size,
                                  bitsPerSample: 8, samplesPerPixel: 4, hasAlpha: true, isPlanar: false,
                                  colorSpaceName: .deviceRGB, bytesPerRow: 0, bitsPerPixel: 0)!
    NSGraphicsContext.saveGraphicsState()
    NSGraphicsContext.current = NSGraphicsContext(bitmapImageRep: bitmap)
    let transform = AffineTransform(scale: CGFloat(size) / 1024)
    (transform as NSAffineTransform).concat()
    let tile = rect(65, 65, 894, 894, 200)
    NSGradient(starting: color(20, 34, 68), ending: color(66, 132, 199))!.draw(in: tile, angle: 67)
    stroke(rect(72, 72, 880, 880, 193), color(212, 244, 255, 0.35), 11)
    let screen = rect(220, 312, 584, 381, 76)
    NSGradient(starting: color(19, 38, 77), ending: color(66, 136, 191))!.draw(in: screen, angle: 76)
    stroke(screen, color(206, 244, 255), 38)
    let stand = NSBezierPath()
    stand.move(to: NSPoint(x: 512, y: 295))
    stand.line(to: NSPoint(x: 512, y: 218))
    stand.move(to: NSPoint(x: 415, y: 217))
    stand.line(to: NSPoint(x: 609, y: 217))
    stroke(stand, color(206, 244, 255), 38)
    let center = NSPoint(x: 512, y: 502)
    let sun = NSBezierPath(ovalIn: NSRect(x: center.x - 62, y: center.y - 62, width: 124, height: 124))
    NSGradient(starting: color(255, 172, 77), ending: color(255, 234, 161))!.draw(in: sun, angle: 85)
    let rays = NSBezierPath()
    for index in 0..<8 {
        let angle = CGFloat(index) * .pi / 4
        rays.move(to: NSPoint(x: center.x + 91 * cos(angle), y: center.y + 91 * sin(angle)))
        rays.line(to: NSPoint(x: center.x + 115 * cos(angle), y: center.y + 115 * sin(angle)))
    }
    stroke(rays, color(255, 218, 133), 19)
    NSGraphicsContext.restoreGraphicsState()
    return bitmap.representation(using: .png, properties: [:])!
}
for side in [16, 32, 128, 256, 512] {
    for scale in [1, 2] {
        let suffix = scale == 2 ? "@2x" : ""
        try render(side * scale).write(to: folder.appendingPathComponent("icon_\(side)x\(side)\(suffix).png"))
    }
}
